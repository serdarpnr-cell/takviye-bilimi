{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Takviye Bilimi parti analizi kaydı (data/parti_analizleri.json içindeki 'partiler' öğesi)",
  "type": "object",
  "required": ["parti_no", "demo", "urun_id", "laboratuvar", "analiz_tarihi", "sonuclar"],
  "properties": {
    "parti_no": {"type": "string", "minLength": 1},
    "demo": {"type": "boolean", "description": "true yalnızca gösterim kaydı (DEMO-0001); gerçek analizde false"},
    "urun_id": {"type": "string", "description": "data/urunler.json ürün kodu"},
    "laboratuvar": {"type": "string"},
    "akreditasyon_no": {"type": ["string", "null"], "description": "TÜRKAK ya da eşdeğer akreditasyon numarası"},
    "analiz_tarihi": {"type": "string", "format": "date"},
    "rapor_no": {"type": "string"},
    "yayin_onayi": {"type": "object", "required": ["onaylayan", "tarih"],
                    "properties": {"onaylayan": {"type": "string"}, "tarih": {"type": "string", "format": "date"}}},
    "sonuclar": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["etken_madde", "etiketteki", "olculen", "birim"],
      "properties": {"etken_madde": {"type": "string"}, "etiketteki": {"type": "number"}, "olculen": {"type": "number", "minimum": 0},
                     "birim": {"type": "string"}, "yontem": {"type": ["string", "null"]}}}},
    "not": {"type": "string"}
  },
  "if": {"properties": {"demo": {"const": false}}},
  "then": {"required": ["rapor_no", "yayin_onayi"]}
}
